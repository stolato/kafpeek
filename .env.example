# Copy to .env and fill in. .env is git-ignored — never commit credentials.

# Where the UI listens. 127.0.0.1 = only this machine (default, safest).
# Use 0.0.0.0:8090 to expose it on the network — then also set UI_USERNAME/UI_PASSWORD and ALLOWED_HOSTS.
HTTP_ADDR=127.0.0.1:8090

# Hostnames/IPs people use to reach the UI besides localhost (DNS-rebinding protection).
# e.g. ALLOWED_HOSTS=kafpeek.mycompany.internal,10.0.3.15   ("*" disables the check)
# ALLOWED_HOSTS=

# Only behind a reverse proxy/load balancer: trust X-Forwarded-For for client IPs in logs.
# TRUST_PROXY=false

# Login for the UI (HTTP Basic auth). Set both to enable; leave both empty to disable.
# Use HTTPS (or keep it on localhost/VPN): Basic auth sends the password with every request.
# UI_USERNAME=admin
# UI_PASSWORD=change-me
# LOG_LEVEL=debug

# ---------- Local development (compose.yaml) ----------
KAFKA_CLUSTER_NAME=local
KAFKA_BROKERS=localhost:9092
KAFKA_AUTH=none

# ---------- AWS MSK with IAM (access key + secret) ----------
# Use the IAM bootstrap brokers: port 9098 inside the VPC, 9198 for public access.
# (AWS console > MSK > cluster > "View client information")
# KAFKA_CLUSTER_NAME=msk-prod
# KAFKA_BROKERS=b-1.mycluster.abc123.c2.kafka.us-east-1.amazonaws.com:9098,b-2.mycluster.abc123.c2.kafka.us-east-1.amazonaws.com:9098
# KAFKA_AUTH=aws-iam
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=          # only for temporary credentials
# AWS_PROFILE=                # alternative to keys: use a profile from ~/.aws
# AWS_REGION=us-east-1        # optional: normally derived from the broker hostname

# ---------- AWS MSK with SASL/SCRAM (username + password) ----------
# Ports 9096 (VPC) / 9196 (public).
# KAFKA_AUTH=scram-sha-512
# KAFKA_USERNAME=...
# KAFKA_PASSWORD=...

# Disable every write from the UI (producing messages). Recommended for shared/prod setups.
# KAFKA_READ_ONLY=true

# ---------- Other clusters: see README "Conexões suportadas" ----------
# Confluent Cloud:  KAFKA_AUTH=plain, KAFKA_USERNAME=<api key>, KAFKA_PASSWORD=<api secret>
# Azure Event Hubs: KAFKA_AUTH=plain, port 9093, KAFKA_PASSWORD=<connection string>,
#   KAFKA_USERNAME='$ConnectionString'   <- single quotes: unquoted, $ConnectionString would be expanded to ""

# ---------- TLS ----------
# Private CA (PEM) to trust in addition to the system CAs:
# KAFKA_TLS_CA_FILE=/certs/ca.pem
# Mutual TLS (client certificate auth, e.g. MSK ports 9094/9194, Strimzi, Aiven):
# KAFKA_TLS_CERT_FILE=/certs/client.pem
# KAFKA_TLS_KEY_FILE=/certs/client.key
# Override the name used for SNI/certificate verification:
# KAFKA_TLS_SERVER_NAME=

# TLS is enabled automatically for any auth other than "none" and when certificates are set.
# KAFKA_TLS=true
# KAFKA_TLS_INSECURE_SKIP_VERIFY=false

# ---------- Schema Registry (optional) ----------
# Decodes Avro / Protobuf / JSON Schema messages (Confluent, Redpanda, Karapace, Apicurio ccompat):
# SCHEMA_REGISTRY_URL=http://localhost:8081
# SCHEMA_REGISTRY_USERNAME=
# SCHEMA_REGISTRY_PASSWORD=
# SCHEMA_REGISTRY_TLS_CA_FILE=
